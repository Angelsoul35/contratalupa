# Contratalupa configuration (prefix CL_)
CL_ENVIRONMENT=local
# LLM provider cascade, tried in order; each reads its own API key from the env.
CL_LLM_SPEC=anthropic,openai,gemini,deepseek,ollama
CL_LLM_MAX_TOKENS=400
# Provider API keys (set the ones you use; unset providers are skipped):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_HOST=http://localhost:11434
